# MANIFEST.in — extra files to include in the yapsnap source distribution.
#
# setuptools already bundles the package (yapsnap/, including its package-data
# model_checksums.sha256), README.md and pyproject.toml. The lines below add the
# security-hardening files so `pip install` from an sdist gets a verifiable,
# reproducible setup.
#
# NOTE: the model checksum manifest is shipped AND installed via package-data in
# pyproject.toml ([tool.setuptools.package-data]), so it no longer needs an
# explicit include here. It lives at yapsnap/model_checksums.sha256 and is
# picked up automatically.

# Hash-pinned dependency lock for `pip install --require-hashes`.
include requirements-lock.txt

# Helper that regenerates the lock + checksum files.
include scripts/gen_hashes.sh

# Never ship caches / build cruft.
global-exclude __pycache__
global-exclude *.py[cod]
global-exclude *.part
